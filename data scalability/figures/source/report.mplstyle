# Adapted from scientific-visualization/assets/publication.mplstyle.
# General report style; no journal-specific compliance claim.
figure.facecolor: white
figure.autolayout: False
figure.constrained_layout.use: False
font.family: sans-serif
font.sans-serif: DejaVu Sans, Arial
font.size: 9
axes.labelsize: 9
axes.titlesize: 10
axes.titleweight: semibold
axes.linewidth: 0.8
axes.edgecolor: 596073
axes.labelcolor: 596073
axes.spines.top: False
axes.spines.right: False
axes.axisbelow: True
axes.grid: False
xtick.labelsize: 8.5
ytick.labelsize: 8.5
xtick.color: 596073
ytick.color: 596073
xtick.direction: out
ytick.direction: out
text.color: 596073
lines.linewidth: 1.6
lines.markersize: 4.5
legend.frameon: False
legend.fontsize: 8
grid.color: E8E4DF
grid.linewidth: 0.6
grid.alpha: 0.65
axes.prop_cycle: cycler('color', ['7BB6BA', 'B8442D', '9D725F', 'D7BBA5', 'DBD4CC'])
savefig.dpi: 300
savefig.facecolor: white
savefig.transparent: False
pdf.fonttype: 42
ps.fonttype: 42
svg.fonttype: none
image.cmap: cividis
